---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NavBar from '@/components/NavBar.astro';
import HeroSection from '@/components/HeroSection.astro';
import HowItWorksSection from '@/components/HowItWorksSection.astro';
import QuizSection from '@/components/QuizSection.astro';
import UniqueSection from '@/components/UniqueSection.astro';
import WaitlistSection from '@/components/WaitlistSection.astro';
import FaqSection from '@/components/FaqSection.astro';
import SiteFooter from '@/components/SiteFooter.astro';
---

<BaseLayout>
  <NavBar />
  <main id="contenido" tabindex="-1">
    <HeroSection />
    <HowItWorksSection />
    <QuizSection />
    <WaitlistSection />
    <UniqueSection />
    <FaqSection />
  </main>
  <SiteFooter />
</BaseLayout>
