---
import { Image } from 'astro:assets';
import LogoField from '@/components/LogoField.astro';
import heroImage from '@/assets/images/backdround-image-2.png';

const avatars = [
  'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=80&h=80&q=80&auto=format&fit=crop&crop=faces',
  'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=80&h=80&q=80&auto=format&fit=crop&crop=faces',
  'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=80&h=80&q=80&auto=format&fit=crop&crop=faces',
];
---

<section id="inicio" class="section relative overflow-hidden">
  <LogoField />

  <div class="container-blazek relative z-10 grid items-center gap-[var(--space-stack)] md:grid-cols-2">
    <div class="animate-rise-in flex flex-col gap-6">
      <h1 class="text-hero">
        El cambio<br />
        es lo <span class="text-primary">único</span><br />
        seguro
      </h1>

      <p class="text-body-alt max-w-md text-lg text-foreground/80">
        No te quedes quieto. Viví tu <span class="text-[hsl(var(--brand-red))]">evolución</span>.
      </p>

      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
        <a href="#quiz" class="btn btn--primary">
          Explorá tu prenda
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <span class="bzk-avatars">
          {avatars.map((src) => (
            <img src={src} alt="" loading="lazy" decoding="async" width="40" height="40" />
          ))}
        </span>
        <p class="max-w-[16rem] text-sm text-foreground/75">
          <strong class="text-foreground">+1200 personas</strong> ya se sumaron a la comunidad oficial.
        </p>
      </div>
    </div>

    <div class="animate-rise-in relative mx-auto w-full max-w-md">
      <div class="bzk-hero-blob">
        <Image
          src={heroImage}
          alt="Skater de BLAZEK — Rollin' and relaxin"
          loading="eager"
          decoding="async"
          widths={[400, 700, 900]}
          sizes="(min-width: 768px) 40vw, 90vw"
        />
      </div>
    </div>
  </div>
</section>
