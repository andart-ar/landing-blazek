---
import { Image } from 'astro:assets';
import LogoField from '@/components/LogoField.astro';
import heroImage from '@/assets/images/backdround-image-2.png';
---

<section id="inicio" class="clip-x section relative">
  <LogoField />

  <div class="container-blazek relative z-10 grid items-center gap-[var(--space-stack)] md:grid-cols-2">
    <div class="animate-rise-in flex min-w-0 flex-col gap-6">
      <h1 class="text-hero">
        El cambio<br />
        es lo <span class="text-primary">único</span><br />
        seguro
      </h1>

      <p class="text-body-alt max-w-md text-lg text-foreground/80">
        No te quedes quieto. Viví tu <span class="text-primary">evolución</span>.
      </p>

      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
        <a href="#quiz" class="btn btn--primary">
          Explorá tu prenda
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <div class="animate-rise-in relative mx-auto w-full min-w-0 max-w-md">
      <div class="bzk-hero-blob">
        <Image
          src={heroImage}
          alt="Skater de BLAZEK — Rollin' and relaxin"
          loading="eager"
          decoding="async"
          widths={[400, 700, 900]}
          sizes="(min-width: 768px) 28rem, 90vw"
        />
      </div>
    </div>
  </div>
</section>
