---
const year = new Date().getFullYear();
---

<footer class="bzk-divider bg-secondary text-secondary-foreground">
  <div class="container-blazek flex flex-col gap-[var(--space-stack)] py-[var(--space-stack)] md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col gap-2">
      <span class="font-display text-3xl uppercase tracking-tight">BLAZEK</span>
      <span class="text-eyebrow text-secondary-foreground/60">Próximamente · Buenos Aires</span>
    </div>

    <div class="flex flex-col gap-3">
      <span class="text-body-alt text-secondary-foreground/75">Sé de los primeros en tenerla.</span>
      <div class="flex flex-wrap gap-4">
        <a href="https://tienda.blazekclub.com" target="_blank" rel="noopener noreferrer" class="bzk-stamp border-secondary-foreground/40 text-secondary-foreground">Comprá ahora</a>
        <a href="https://www.instagram.com/p/DcZgKZNjx-R/" target="_blank" rel="noopener noreferrer" class="bzk-stamp border-secondary-foreground/40 text-secondary-foreground">Instagram</a>
      </div>
    </div>
  </div>

  <div class="container-blazek flex flex-wrap items-center justify-between gap-2 pb-[var(--space-stack)]">
    <span class="text-sm text-secondary-foreground/55">© {year} BLAZEK. Todos los derechos reservados.</span>
    <a href="https://andart.company/" target="_blank" rel="noopener noreferrer" class="group text-sm text-secondary-foreground/55 transition-colors hover:text-secondary-foreground">
      Shipped by <span class="font-semibold text-primary transition-colors group-hover:text-primary/80">Andart</span>
    </a>
  </div>
</footer>
