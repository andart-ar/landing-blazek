---
import Quiz from '@/components/Quiz.tsx';
---

<section id="quiz" class="section bg-muted">
  <div class="container-blazek flex flex-col gap-[var(--space-stack)]">
    <div class="flex max-w-2xl flex-col gap-4">
      <span class="text-eyebrow">El test</span>
      <h2 class="text-section-title">Encontrá tu prenda</h2>
      <p class="text-lg text-muted-foreground">
        Seis preguntas rápidas. Al final, la prenda que más se parece a vos.
      </p>
    </div>

    <div class="card-blazek bg-background">
      <Quiz client:visible />
    </div>
  </div>
</section>
