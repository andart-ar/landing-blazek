---
import Quiz from '@/components/Quiz.tsx';
import LogoField from '@/components/LogoField.astro';

interface Props {
  garmentImages: Record<string, string>;
}

const { garmentImages } = Astro.props;
const garmentImageUrls = Object.values(garmentImages);
---

<section
  id="quiz"
  class="clip-x section-warm section relative"
  data-garment-image-urls={JSON.stringify(garmentImageUrls)}
>
  <LogoField tone="light" />

  <div class="container-blazek relative z-10 flex flex-col gap-[var(--space-stack)]">
    <div class="flex max-w-2xl flex-col gap-3">
      <h2 class="text-section-title text-white">Encontrá tu prenda</h2>
      <p class="text-lg text-white/80">
        Elegí las cualidades con las que más te identificás y descubrí la prenda que más se parece a vos.
      </p>
    </div>

    <div class="grid gap-[var(--space-stack)] lg:grid-cols-[1fr_auto] lg:items-start">
      <Quiz client:visible garmentImages={garmentImages} />

      <aside class="bzk-trait-hint mx-auto max-w-[14rem] text-white lg:mx-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.4 6 16 4a2 2 0 0 1-4 2 2 2 0 0 1-4-2L3.6 6a1 1 0 0 0-.5 1.3l1.4 3.3a1 1 0 0 0 1.3.5L8 10.5V19a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-8.5l2.2.9a1 1 0 0 0 1.3-.5l1.4-3.3a1 1 0 0 0-.5-1.3Z"/>
        </svg>
        <p class="text-sm">
          Elegí al menos <strong class="text-white">2</strong> para descubrir tu prenda ideal.
        </p>
      </aside>
    </div>
  </div>
</section>

<script>
  function warmGarmentImageCache() {
    const section = document.getElementById('quiz');
    const rawUrls = section?.dataset.garmentImageUrls;
    if (!rawUrls) return;

    const urls: string[] = JSON.parse(rawUrls);
    for (const url of urls) {
      const image = new Image();
      image.src = url;
    }
  }

  if (document.readyState === 'complete') {
    warmGarmentImageCache();
  } else {
    window.addEventListener('load', warmGarmentImageCache, { once: true });
  }
</script>
