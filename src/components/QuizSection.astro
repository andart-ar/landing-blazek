---
import Quiz from '@/components/Quiz.tsx';
---

<section id="quiz" class="section bg-secondary text-secondary-foreground">
  <div class="container-blazek flex flex-col gap-[var(--space-stack)]">
    <div class="flex max-w-2xl flex-col gap-3">
      <h2 class="text-section-title">Encontrá tu prenda</h2>
      <p class="text-lg text-secondary-foreground/85">
        Elegí lo que va con vos y descubrí la prenda que más se parece.
      </p>
    </div>

    <Quiz client:visible />
  </div>
</section>
