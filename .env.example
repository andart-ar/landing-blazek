# Copy to .env and fill in the real values: cp .env.example .env
# All variables are required — the build fails if any is missing.

# Resend API key with "Sending access" permission.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# UUID of the audience that stores waitlist contacts.
# Create one at https://resend.com/audiences and copy the ID from the URL.
RESEND_AUDIENCE_ID=00000000-0000-0000-0000-000000000000

# Sender shown in the welcome email. Format: "Name <address@domain>".
# The domain must be verified in Resend (SPF + DKIM) or every send fails.
RESEND_FROM_EMAIL=BLAZEK <info@blazekclub.com>

# Public site origin, no trailing slash.
# Used to build the email logo URL and to validate the request Origin header.
# On localhost the email logo will not load — that is expected.
#
# In production: https://www.blazekclub.com
# The value must match the browser Origin header exactly or every submission
# returns 403. The apex domain redirects to www in Vercel so a single origin
# reaches this endpoint — keep that redirect in place if this value changes.
PUBLIC_SITE_URL=http://localhost:4321

# Cloudflare Turnstile keys, from https://dash.cloudflare.com > Turnstile.
# The values below are Cloudflare's public test keys: they always pass and are
# meant for local development. Replace both with the real widget keys in Vercel.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
